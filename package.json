    "@nestjs/platform-express": "12.1.0",
    "@nestjs/testing": "12.1.0",
    "@types/jest": "30.0.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "jest": "30.5.2",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "source-map-support": "0.5.21",
    "ts-jest": "29.4.13",
    "ts-node": "10.9.2",
    "typescript": "4.9.5",
    "winston": "3.16.0"
